<!doctype html>
<html lang="<%= (s.site_language || 'it').slice(0, 2) %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<meta name="robots" content="<%= meta.robots %>">
<link rel="canonical" href="<%= meta.canonical %>">
<link rel="alternate" hreflang="<%= s.site_language %>" href="<%= meta.canonical %>">
<% if (meta.prev) { %><link rel="prev" href="<%= abs(meta.prev) %>"><% } %>
<% if (meta.next) { %><link rel="next" href="<%= abs(meta.next) %>"><% } %>
<% if (meta.markdownAlt) { %><link rel="alternate" type="text/markdown" href="<%= abs(meta.markdownAlt) %>" title="Versione Markdown"><% } %>
<link rel="alternate" type="application/rss+xml" title="<%= s.site_name %> RSS" href="<%= siteUrl %>/feed.xml">
<link rel="alternate" type="application/feed+json" title="<%= s.site_name %> JSON Feed" href="<%= siteUrl %>/feed.json">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/logo-512.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0c0f1a" media="(prefers-color-scheme: dark)">
<meta property="og:site_name" content="<%= s.site_name %>">
<meta property="og:locale" content="<%= (s.site_language || 'it-IT').replace('-', '_') %>">
<meta property="og:type" content="<%= meta.type %>">
<meta property="og:title" content="<%= meta.ogTitle %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:url" content="<%= meta.canonical %>">
<meta property="og:image" content="<%= meta.image %>">
<meta property="og:image:alt" content="<%= meta.imageAlt %>">
<% if (meta.type === 'article') { %>
<meta property="article:published_time" content="<%= meta.publishedAt %>">
<meta property="article:modified_time" content="<%= meta.modifiedAt %>">
<% if (meta.section) { %><meta property="article:section" content="<%= meta.section %>"><% } %>
<% meta.tags.forEach(function(t){ %><meta property="article:tag" content="<%= t %>">
<% }) %>
<% if (meta.authorName) { %><meta name="author" content="<%= meta.authorName %>"><% } %>
<% } else if (meta.modifiedAt) { %><meta property="og:updated_time" content="<%= meta.modifiedAt %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<% if (s.twitter_handle) { %><meta name="twitter:site" content="@<%= s.twitter_handle %>"><% } %>
<% if (s.google_site_verification) { %><meta name="google-site-verification" content="<%= s.google_site_verification %>"><% } %>
<% if (s.bing_site_verification) { %><meta name="msvalidate.01" content="<%= s.bing_site_verification %>"><% } %>
<script>(function(){try{var t=localStorage.getItem('tm-theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}})()</script>
<link rel="stylesheet" href="/css/site.css?v=<%= assetV %>">
<%- meta.jsonld %>
<% if (s.plausible_domain) { %><script defer data-domain="<%= s.plausible_domain %>" src="https://plausible.io/js/script.outbound-links.js"></script><% } %>
<% if (s.adsense_client) { %><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= s.adsense_client %>" crossorigin="anonymous"></script><% } %>
<%- s.head_code || '' %>
</head>
<body>
<a class="skip" href="#main">Vai al contenuto</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/" aria-label="<%= s.site_name %> — home">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="var(--accent)"/><path d="M8 21l5-6 4 4 7-9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="24" cy="10" r="2.4" fill="var(--lime)"/></svg>
      <span><%= s.site_name %></span>
    </a>
    <form class="header-search" action="/cerca" method="get" role="search">
      <label class="sr-only" for="q-top">Cerca nel sito</label>
      <input id="q-top" type="search" name="q" placeholder="Cerca news, modelli, strumenti…" autocomplete="off">
    </form>
    <div class="header-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Cambia tema chiaro/scuro">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.4 5.4 0 0 1-9.54-5.18A7 7 0 0 1 12 3z"/></svg>
      </button>
      <a class="btn btn-primary btn-sm" href="#newsletter">Newsletter</a>
    </div>
  </div>
  <nav class="main-nav" aria-label="Sezioni">
    <div class="wrap nav-scroll">
      <a href="/articoli" <%- currentPath === '/articoli' ? 'aria-current="page"' : '' %>>Ultime</a>
      <% navCats.forEach(function(c){ %><a href="/categoria/<%= c.slug %>" <%- currentPath === '/categoria/' + c.slug ? 'aria-current="page"' : '' %>><%= c.name %></a><% }) %>
      <a href="/modelli-ai" <%- currentPath.startsWith('/modelli-ai') ? 'aria-current="page"' : '' %>>Modelli AI</a>
      <a href="/dati" <%- currentPath.startsWith('/dati') ? 'aria-current="page"' : '' %>>Dati</a>
      <a href="/strumenti" <%- currentPath.startsWith('/strumenti') ? 'aria-current="page"' : '' %>>Strumenti</a>
      <a href="/glossario" <%- currentPath.startsWith('/glossario') ? 'aria-current="page"' : '' %>>Glossario</a>
    </div>
  </nav>
</header>
<%- comp.adSlot('header') %>
<main id="main">
