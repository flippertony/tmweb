# Porta HTTP
PORT=3000
# URL pubblico (senza slash finale) — usato per canonical, sitemap, JSON-LD
SITE_URL=http://localhost:3000
# Fuso orario redazione (date di pubblicazione programmate)
TZ=Europe/Rome
# production abilita cookie Secure e cache aggressiva
NODE_ENV=development
# Percorso database SQLite
DB_PATH=./data/trendmind.db
# Segreto per firmare i cookie di sessione (stringa lunga e casuale)
SESSION_SECRET=cambia-questa-stringa-con-almeno-32-caratteri-casuali
# Durata cache HTML pagine pubbliche in secondi (0 = disattivata)
PAGE_CACHE_TTL=60
# Se dietro reverse proxy (Nginx, Cloudflare, Render...) imposta a 1
TRUST_PROXY=0
