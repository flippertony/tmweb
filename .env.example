# Copia questo file in ".env" e compila i valori.

# Chiave API di Claude: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Modello usato da Jarvis (default: il più capace della linea Opus)
JARVIS_MODELLO=claude-opus-5-5

# Quanto "ragiona" Jarvis in chat: low | medium | high | xhigh | max
JARVIS_EFFORT_CHAT=medium

# Livello di autonomia (1, 2 o 3) — vedi README:
#   1 = Prepara: legge da solo, tutto il resto aspetta la tua approvazione
#   2 = Agisce sul reversibile: CRM, memoria e bozze in automatico
#   3 = Agisce anche all'esterno: bozze su WordPress ecc. in automatico
# Invio email e pubblicazioni chiedono SEMPRE la tua approvazione.
JARVIS_AUTONOMIA=2

# Tetto di spesa giornaliero stimato in dollari: superato, le automazioni si fermano
JARVIS_BUDGET_GIORNALIERO_USD=5

# Porta della dashboard (http://localhost:8765)
JARVIS_PORTA=8765
